# 环境变量配置模板
# 复制此文件为 .env 并填入真实信息
# .env 文件不会被提交到 Git 仓库

# ========== 邮件配置 ==========
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_USE_TLS=true
EMAIL_FROM=your_email@qq.com
EMAIL_TO=recipient@example.com
SMTP_PASSWORD=your_smtp_auth_code

# ========== 数据库配置 ==========
# 数据库文件路径（默认：src/data/word.db）
# DATABASE_PATH=

# ========== 系统配置 ==========
# 每日新词数量
DAILY_NEW_WORDS=5

# 词库配置
WORD_FILE=resources/CET4_edited.txt
HISTORY_FILE=resources/word_history.json

# 服务器地址（用于邮件交互链接）
SERVER_URL=http://your-server-ip

# ========== 监控通知（可选）==========
# Webhook URL（支持钉钉、企业微信、飞书、Server酱）
WEBHOOK_URL=

# ========== Web 面板访问控制（推荐）==========
# Web 管理面板登录账号（默认 admin）
WEB_ADMIN_USER=admin
# Web 管理面板登录密码（建议设置强密码）
WEB_ADMIN_PASSWORD=change_me
# 用于签名 Session 的密钥（必须设置，重启保持登录态）
WEB_SECRET_KEY=change_me_to_a_long_random_string

# 是否允许普通用户自行注册（默认 true）
WEB_ALLOW_REGISTER=true
